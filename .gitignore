*.tfvars
*.tfvars.json

# Terraform plan files
*.tfplan
tfplan
tfplan.*

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform lock info
.terraform.tfstate.lock.info

# Terraform CLI configuration
.terraformrc
terraform.rc

# Terraform generated JSON/output files
terraform/*.json

# Generated Kubernetes config
kubeconfig.yaml


